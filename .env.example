# PromptToPlay 环境变量
# 复制此文件为 .env 并填入实际值

# DeepSeek API 密钥（通过 QuickRouter 中转）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat

# JWT 签名密钥（生产环境请改为随机字符串）
JWT_SECRET=change-this-to-a-random-string-in-production

# 服务器端口（Railway 自动设置，本地默认 3000）
PORT=3000

# 站点域名（生产环境改为实际域名）
DOMAIN=http://localhost:3000

# 开发模式：true=支付直接到账免费积分
DEV_MODE=true
