# ============================================
# PromptToPlay 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ----- 必配项 -----

# DeepSeek API 密钥
# 官方申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# JWT 签名密钥（生产环境请改为随机长字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-random-string-in-production

# ----- AI 模型配置（可选）-----

# API 地址，默认 DeepSeek 官方
# 官方：https://api.deepseek.com/v1
# 中转示例：https://api.quickrouter.ai/v1
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 模型名称
DEEPSEEK_MODEL=deepseek-chat

# ----- 服务器配置（可选）-----

# 服务端口
PORT=3000

# 站点公开域名（用于 Stripe 回调、分享链接等）
DOMAIN=http://localhost:3000

# 运行环境：development / production
NODE_ENV=development

# 开发模式：true=支付直接到账免费积分（仅本地开发用）
DEV_MODE=true

# ----- 数据库配置（可选）-----

# SQLite 数据库文件路径，默认 ./data/prompttoplay.db
# DB_PATH=./data/prompttoplay.db

# ----- 支付配置（可选，不配则禁用支付）-----

# Stripe 支付密钥
# STRIPE_SECRET_KEY=sk_test_xxx

# Stripe Webhook 签名密钥
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ----- 安全配置（可选）-----

# 全局速率限制（每分钟请求数），默认 60
# RATE_LIMIT_MAX=60
